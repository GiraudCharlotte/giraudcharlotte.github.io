{% assign labels = site.data[site.active_lang].strings %}
<header>
  <nav id="navbar" class="navbar fixed-top" aria-label="{{ labels.navigation }}">
    <div class="container site-navbar">
      <div class="header-contact">
        <a href="mailto:charlotte.giraudm@gmail.com" aria-label="{{ labels.email }}" title="{{ labels.email }}">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 5h18v14H3V5zm1 1 8 6 8-6M4 18V8m16 10V8"/>
          </svg>
        </a>
        <a href="https://fr.linkedin.com/in/charlotte-giraud-370527a7" aria-label="{{ labels.linkedin }}" title="{{ labels.linkedin }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="linkedin-icon">
            <path d="M6.5 8a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM5 10h3v9H5zm6 0h3v1.3c.7-1 1.6-1.5 3-1.5 2.6 0 4 1.6 4 4.7V19h-3v-4.2c0-1.6-.6-2.4-1.8-2.4-1.3 0-2.2 1-2.2 2.5V19h-3z"/>
          </svg>
        </a>
        <a href="https://github.com/GiraudCharlotte" aria-label="{{ labels.github }}" title="{{ labels.github }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="github-icon">
            <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.58 9.58 0 0 1 12 6.82c.85 0 1.71.11 2.51.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/>
          </svg>
        </a>
      </div>
      <button class="mobile-menu" type="button" aria-controls="navbarNav" aria-expanded="false" aria-label="{{ labels.menu }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
      <div id="navbarNav" class="site-menu">
        <ul class="site-nav-links">
          {% for item in labels.nav %}
            <li>
              <a
                href="{{ item.url | relative_url }}"
                {% if page.page_id == item.id %}
                  aria-current="page" class="current"
                {% endif %}
              >
                {{- item.label -}}
              </a>
            </li>
          {% endfor %}
        </ul>
        <div class="header-tools">
          {% if site.active_lang == site.default_lang %}
            <a
              class="language-switch"
              {% static_href -%}
              href="{{ site.baseurl }}/en{{ page.url | remove: 'index.html' }}"
              {% endstatic_href %}
              lang="en"
              hreflang="en"
              aria-label="{{ labels.language }}"
              >EN</a
            >
          {% else %}
            <a
              class="language-switch"
              {% static_href -%}
              href="{{ site.baseurl }}{{ page.url | remove: 'index.html' }}"
              {% endstatic_href %}
              lang="fr"
              hreflang="fr"
              aria-label="{{ labels.language }}"
              >FR</a
            >
          {% endif %}
          <button id="light-toggle" type="button" title="{{ labels.theme }}" aria-label="{{ labels.theme }}">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5z"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </nav>
</header>
